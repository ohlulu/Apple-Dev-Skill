# ============================================================================
# Makefile — {{PROJECT_NAME}}
# ============================================================================
#
# Usage:  make            → show help
#         make gen        → close Xcode + tuist generate
#         make test       → run tests (ONLY= to narrow)
#         make run        → build + install + launch on the pinned simulator
#         make warnings   → show Swift warnings (IDE parity)
#         make release    → archive + upload (delegates to scripts/)
#
# Conventions:
#   - Every public target has a ## comment above it (shown in `make help`)
#   - `xc` macro centralises all xcodebuild calls and result verification
#   - Recipes over ~10 lines, or containing AppleScript, live in scripts/
#
# Guide: references/makefile.md

.DEFAULT_GOAL := help

# bash required — `set -o pipefail` in the xc macro is not POSIX sh
SHELL     := /bin/bash
REPO_ROOT := $(CURDIR)

# ---------------------------------------------------------------------------
# Config — adapt these to your project
# ---------------------------------------------------------------------------

WORKSPACE := {{PROJECT_NAME}}.xcworkspace
SCHEME    := {{PROJECT_NAME}}

# Simulator destination. SIM_NAME/SIM_OS are the single source for both the
# xcodebuild destination ($(SIM)) and simctl UDID resolution ($(SIM_UDID_SH)).
# Ask the user which device/OS to pin: xcrun simctl list devices available
SIM_NAME := iPhone 17 Pro
SIM_OS   := 26.4
SIM      := platform=iOS Simulator,name=$(SIM_NAME),OS=$(SIM_OS)

# Resolves the pinned sim's UDID. The awk range scopes the search to the
# $(SIM_OS) runtime section, so a same-named device under another runtime can
# never win. Use as UDID=$$($(SIM_UDID_SH)); empty result = device missing.
SIM_UDID_SH := xcrun simctl list devices available | awk '/^-- iOS $(SIM_OS) --/{f=1;next} /^--/{f=0} f' | grep -F '$(SIM_NAME) (' | grep -oE '[0-9A-F-]{36}' | head -1

# Physical-device projects: delete the three vars above, add a sourceable
# scripts/device-select.sh instead (see references/makefile.md § Physical
# device selection) and use -destination "id=$$UDID".

# DerivedData — project-local avoids cross-project cache pollution.
# To share the IDE's cache instead (large projects, 10min+ cold builds):
# drop -derivedDataPath from the xc macro AND drop -skipMacroValidation,
# which changes the build-settings fingerprint and forces full rebuilds.
DD := $(REPO_ROOT)/.derivedData

# Log directory — nested under DerivedData so `clean` sweeps it automatically
LOGDIR := $(DD)/logs

# Lines streamed to the screen while a build runs; everything goes to the log.
# `error: ` keeps the trailing space: a bare `error:` also matches Objective-C
# selectors carrying an `error:` parameter label (`patternForKey:error:` and
# friends), which the simulator logs on perfectly green runs. Real diagnostics
# are always `error: <message>`, so the space loses nothing.
ERROR_PATTERN := error: |BUILD FAILED|TEST FAILED|Testing failed
# Crash markers. Anchor these to how a crash is REPORTED, not to the signal
# name: a bare `crashed`, or a bare `SIGABRT`, also matches ordinary logging
# that merely names the signal. Crashlytics prints "The signal SIGABRT has a
# non-Crashlytics handler" on every green run, which would redden the suite.
# Widen only after checking what your own SDKs emit on a passing run.
CRASH_PATTERN := Restarting after unexpected exit|Crashed:|due to (signal )?(SIGABRT|SIGSEGV)|terminated due to

# Version source (pick one, delete the other)
# --- xcconfig ---
VERSION_FILE := $(REPO_ROOT)/App/Configs/{{PROJECT_NAME}}.xcconfig
READ_VERSION  = grep '^MARKETING_VERSION' $(VERSION_FILE) | sed 's/.*= *//'
SET_VERSION   = sed -i '' 's/^MARKETING_VERSION = .*/MARKETING_VERSION = $(VERSION)/' $(VERSION_FILE)
READ_BUILD    = grep '^CURRENT_PROJECT_VERSION' $(VERSION_FILE) | sed 's/.*= *//'
SET_BUILD     = sed -i '' 's/^CURRENT_PROJECT_VERSION = .*/CURRENT_PROJECT_VERSION = $(1)/' $(VERSION_FILE)
# --- Tuist (Project.swift) ---
# VERSION_FILE := $(REPO_ROOT)/Project.swift
# READ_VERSION = grep 'let marketingVersion' $(VERSION_FILE) | sed 's/.*"\(.*\)".*/\1/'
# SET_VERSION  = sed -i '' 's/let marketingVersion = ".*"/let marketingVersion = "$(VERSION)"/' $(VERSION_FILE)
# READ_BUILD   = grep 'let currentProjectVersion' $(VERSION_FILE) | sed 's/[^0-9]//g'
# SET_BUILD    = sed -i '' 's/let currentProjectVersion = ".*"/let currentProjectVersion = "$(1)"/' $(VERSION_FILE)

# Xcode IDE DerivedData for this exact workspace, for `warnings` target parity.
# Match on the WorkspacePath in each candidate's info.plist, not on the name:
# the directory suffix hashes the workspace's absolute path, so a stale entry
# accumulates for every location the project has lived at (worktrees, /tmp
# clones). `-name '<project>-*' | head -1` would pick an arbitrary one and
# clean-build a different checkout. Empty when nothing matches — guarded below.
XCODE_DD = $(shell for d in ~/Library/Developer/Xcode/DerivedData/$(basename $(WORKSPACE))-*; do \
	  [ "$$(/usr/libexec/PlistBuddy -c 'Print :WorkspacePath' "$$d/info.plist" 2>/dev/null)" = "$(REPO_ROOT)/$(WORKSPACE)" ] && echo "$$d" && break; \
	done)

# ---------------------------------------------------------------------------
# xc macro — DRY xcodebuild runner
# ---------------------------------------------------------------------------
# $(1) log-name
# $(2) scheme
# $(3) action (default: test)
# $(4) extra xcodebuild flags (optional, e.g. -only-testing:... -configuration Release)
#
# Green requires all three: exit 0, success marker present, no crash marker.
# Exit code alone lies — incremental builds can exit 0 after a compile error,
# and a crashed test bundle can exit 0 while printing TEST SUCCEEDED.
define xc
	@mkdir -p $(LOGDIR); \
	LOG=$(LOGDIR)/$(1).log; \
	echo "⏳ xcodebuild $(or $(3),test) [$(2)] … (full log: $$LOG)"; \
	set -o pipefail; \
	xcodebuild \
	  -workspace $(WORKSPACE) \
	  -scheme $(2) \
	  -destination '$(SIM)' \
	  -derivedDataPath "$(DD)" \
	  -skipMacroValidation \
	  $(4) \
	  $(or $(3),test) 2>&1 \
	  | tee "$$LOG" \
	  | { grep --line-buffered -E '$(ERROR_PATTERN)' || true; }; \
	RESULT=$$?; \
	if [ $$RESULT -ne 0 ] \
	   || grep -qE '\*\* (BUILD|TEST) FAILED \*\*' "$$LOG" \
	   || ! grep -qE '\*\* (BUILD|TEST) SUCCEEDED \*\*' "$$LOG" \
	   || grep -qE '$(CRASH_PATTERN)' "$$LOG"; then \
	  echo ""; \
	  echo "  ❌ full log → $$LOG"; \
	  exit 1; \
	fi; \
	echo "✅  $(1) ok"
endef

# ===========================================================================
# Targets
# ===========================================================================

# ---------------------------------------------------------------------------
# Tuist
# ---------------------------------------------------------------------------

## Resolve and fetch SPM dependencies
install:
	tuist install

## Close this project's Xcode window and regenerate (no-op if Xcode is closed)
generate gen:
	@osascript scripts/xcode-close.applescript "$(REPO_ROOT)/" 2>/dev/null || true
	tuist generate

## Regenerate workspace and open in Xcode
open: generate
	@open $(WORKSPACE)

# ---------------------------------------------------------------------------
# Test
# ---------------------------------------------------------------------------

## Run tests. ONLY="AppTests/LoginTests" narrows scope (space-separated for several)
test:
	$(call xc,test,$(SCHEME),test,$(foreach t,$(ONLY),-only-testing:$(t)))

# Named targets earn their place when a scope has its own identity (a module's
# scheme, or the CI gate). Everything else is a job for ONLY=.
# ## Run CoreKit scheme only — fast single-module feedback
# test-core:
# 	$(call xc,core,CoreKit)

## Run every test bundle (CI gate)
# test-all: test test-core

# ---------------------------------------------------------------------------
# Build & run
# ---------------------------------------------------------------------------

## Build for the pinned simulator (Debug)
## NOTE: must stay signed. CODE_SIGNING_ALLOWED=NO skips the CodeSign phase,
## leaving only the linker's ad-hoc signature — codesign -dvvv reports
## flags=0x20002(adhoc,linker-signed) instead of flags=0x2(adhoc) — and simulator
## securityd then rejects every Keychain call with -34018: credentials read back
## as nil and writes fail silently. Simulator apps have empty entitlements either
## way, so the signature is what matters, not an application-identifier check.
## That flag is only safe on compile-check targets that are never installed.
build:
	$(call xc,build-debug,$(SCHEME),build,-configuration Debug)

## Build Release — compile check only, never installed
build-release:
	$(call xc,build-release,$(SCHEME),build,-configuration Release CODE_SIGNING_ALLOWED=NO)

## Build + install + launch on the pinned simulator (auto-boots it when shut down)
## Targets $(SIM_NAME) by explicit UDID — never `booted`, which resolves to
## whatever sim happens to be up and can silently reject the install.
run: build
	@UDID=$$($(SIM_UDID_SH)); \
	if [ -z "$$UDID" ]; then \
	  echo "❌ simulator '$(SIM_NAME)' (iOS $(SIM_OS)) not found — create it in Xcode > Devices"; exit 1; \
	fi; \
	APP=$(DD)/Build/Products/Debug-iphonesimulator/$(SCHEME).app; \
	if [ ! -d "$$APP" ]; then \
	  echo "❌ build artifact not found: $$APP"; exit 1; \
	fi; \
	BID=$$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$$APP/Info.plist"); \
	xcrun simctl bootstatus "$$UDID" -b >/dev/null 2>&1 || { \
	  echo "❌ failed to boot '$(SIM_NAME)' ($$UDID)"; exit 1; }; \
	open -g -a Simulator; \
	xcrun simctl install "$$UDID" "$$APP" && \
	xcrun simctl launch "$$UDID" "$$BID"

# ---------------------------------------------------------------------------
# Format & warnings
# ---------------------------------------------------------------------------

## Format all Swift files
format:
	@swiftformat .

## Check formatting (no write)
format-check:
	@swiftformat --lint .

## Show Swift warnings (clean build against Xcode's DerivedData, for IDE parity)
## Only needed under project-local DerivedData; shared-cache projects see IDE
## diagnostics already and can just clean-build.
warnings:
	@if [ -z "$(XCODE_DD)" ]; then \
	  echo "⚠️  No Xcode DerivedData found. Open $(WORKSPACE) in Xcode first."; \
	  exit 1; \
	fi; \
	mkdir -p $(LOGDIR); \
	echo "⏳ clean build (Xcode DerivedData) …"; \
	xcodebuild clean build \
	  -workspace $(WORKSPACE) \
	  -scheme $(SCHEME) \
	  -destination '$(SIM)' \
	  -derivedDataPath "$(XCODE_DD)" \
	  -configuration Debug \
	  > $(LOGDIR)/warnings.log 2>&1; \
	BUILD_EXIT=$$?; \
	if [ $$BUILD_EXIT -ne 0 ] \
	   || grep -qF '** BUILD FAILED **' $(LOGDIR)/warnings.log \
	   || ! grep -qF '** BUILD SUCCEEDED **' $(LOGDIR)/warnings.log; then \
	  echo ""; \
	  echo "❌  BUILD FAILED — full log → $(LOGDIR)/warnings.log"; \
	  exit 1; \
	fi; \
	grep 'warning:' $(LOGDIR)/warnings.log \
	  | grep -v 'appintentsmetadata\|libtool' \
	  | sort -u; \
	COUNT=$$(grep 'warning:' $(LOGDIR)/warnings.log \
	  | grep -v 'appintentsmetadata\|libtool' \
	  | wc -l | tr -d ' '); \
	echo ""; echo "✅  $$COUNT warning(s)"

# ---------------------------------------------------------------------------
# Version
# ---------------------------------------------------------------------------

## Bump marketing version (resets build to 1).  Usage: make bump VERSION=1.1
bump:
	@if [ -z "$(VERSION)" ]; then \
	  echo "❌  Usage: make bump VERSION=1.1"; exit 1; \
	fi
	@$(SET_VERSION)
	@$(call SET_BUILD,1)
	@echo "✅  version → $(VERSION), build → 1"

## Increment build number (+1)
bump-build:
	@CURRENT=$$($(READ_BUILD)); \
	NEXT=$$((CURRENT + 1)); \
	$(call SET_BUILD,$$NEXT); \
	echo "✅  build → $$NEXT"

## Print current marketing + build version
version:
	@printf "version: %s\nbuild:   %s\n" "$$($(READ_VERSION))" "$$($(READ_BUILD))"

# ---------------------------------------------------------------------------
# Release — delegates to scripts/ (Makefile is the menu, scripts/ is the kitchen)
# ---------------------------------------------------------------------------

## Archive + upload to App Store Connect (gate first: make test)
## Facts and deviations live in docs/RELEASING.md.
release:
	@scripts/release.sh

# ---------------------------------------------------------------------------
# Housekeeping
# ---------------------------------------------------------------------------

## Remove DerivedData, Tuist cache, and logs
# `trash` (brew install trash) so mistakes are recoverable; each path guarded
# with [ -d ] so an empty variable can never expand into a bare rm target.
clean:
	@[ -d "$(DD)" ] && trash "$(DD)" && echo "  trashed $(DD) (incl. logs)" || true
	@tuist clean 2>/dev/null || true
	@echo "✅  clean."

# ---------------------------------------------------------------------------
# Help
# ---------------------------------------------------------------------------

## Show available targets
help:
	@awk '/^##/{if(!d){sub(/^## ?/,"");d=$$0};next} /^#/{next} /^[a-zA-Z0-9_-]+( [a-zA-Z0-9_-]+)*:/{if(d){sub(/:.*/,"",$$1);printf "  \033[36m%-16s\033[0m %s\n",$$1,d};d=""} {d=""}' $(MAKEFILE_LIST)

.PHONY: help \
        install generate gen open \
        test build build-release run \
        format format-check warnings \
        bump bump-build version release \
        clean
